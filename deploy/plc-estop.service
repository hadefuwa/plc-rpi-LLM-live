[Unit]
Description=PLC E-Stop AI Status Reporter
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/plc-rpi-LLM-live
Environment=PATH=/home/pi/plc-rpi-LLM-live/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pi/plc-rpi-LLM-live/start_plc_app.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Give the service time to start up
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target 